# Line-ending policy for a Windows + WSL + Linux-CI workflow (org template).
# Deliberately scoped rather than `* text=auto`: only formats that break on the wrong ending.
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cfg     text eol=lf
*.toml    text eol=lf
*.j2      text eol=lf
*.tpl     text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
